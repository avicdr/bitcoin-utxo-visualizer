# Database Configuration
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bitcoin_utxo

# Bitcoin Core RPC Configuration
BITCOIN_RPC_URL=http://127.0.0.1:18443
BITCOIN_RPC_USER=regtest
BITCOIN_RPC_PASSWORD=regtest
BITCOIN_NETWORK=regtest

# Bitcoin Core ZeroMQ (ZMQ) Notification Ports
BITCOIN_ZMQ_RAWTX=tcp://127.0.0.1:28332
BITCOIN_ZMQ_HASHBLOCK=tcp://127.0.0.1:28333

# Rust Backend Server Configuration
HOST=0.0.0.0
PORT=8080
RUST_LOG=info,bitcoin_utxo_backend=debug

# Frontend Next.js Configuration
NEXT_PUBLIC_API_URL=http://localhost:8080
PORT=3000
